# Copy to /etc/ai-multistore/postgres-backup.env only on the production host.
# The installer normally writes this file after BACKUP_OSS_BUCKET is supplied.
BACKUP_OSS_BUCKET=replace-with-private-bucket
BACKUP_OSS_ENDPOINT=https://oss-ap-northeast-2.aliyuncs.com
BACKUP_OSS_ROLE_NAME=aiglxt-prod-backup-role
BACKUP_OSS_PREFIX=postgresql
BACKUP_AGE_RECIPIENT=replace-with-age-public-recipient
BACKUP_LOCAL_ROOT=/var/lib/ai-multistore/backups
BACKUP_LOCK_PATH=/run/ai-multistore/postgres-backup.lock
